# Copy this file to .env locally or on the server, then fill in real secrets.
# Never commit .env or paste real API keys into chat/logs.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAG embedding retrieval. Any OpenAI-compatible embeddings endpoint can be used.
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_VECTOR_BACKEND=sqlite_vec
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=20
RAG_DENSE_RETRIEVAL_ENABLED=true
RAG_STRICT_PRODUCTION=false
RAG_DOCLING_ENABLED=false
RAG_MINERU_COMMAND=
RAG_MINERU_TIMEOUT_SECONDS=180
RAG_PARENT_EXPANSION_ENABLED=true
RAG_RERANKER_ENABLED=true
RAG_RERANKER_BACKEND=bge_calibrated
# Docker build inputs. The revision is pinned for reproducible offline images.
RAG_BGE_MODEL_ID=BAAI/bge-reranker-v2-m3
RAG_BGE_MODEL_REVISION=953dc6f
# Used by local Python runs. Docker Compose overrides this with the baked Linux path.
RAG_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_BGE_RERANKER_USE_FP16=true
# Local Python may download the model; Docker Compose forces offline local-path loading.
RAG_BGE_LOCAL_FILES_ONLY=false
RAG_RERANKER_PREWARM_ENABLED=true
RAG_RERANKER_LOAD_COOLDOWN_SECONDS=300
RAG_RERANKER_MAX_PASSAGE_CHARS=2400
RAG_BUSINESS_CALIBRATION_MAX_DELTA=0.05
RAG_RRF_K=60
RAG_SPARSE_WEIGHT=1.0
RAG_DENSE_WEIGHT=1.0
RAG_SEMANTIC_FALLBACK_ENABLED=false
RAG_CITATION_VALIDATION_ENABLED=true
RAG_GENERATION_REQUIRE_GOLDEN=true
RAG_GOLDEN_MIN_CASES=150
RAG_GOLDEN_AGENTIC_MIN_CASES=25
RAG_GENERATION_INDEX_ENABLED=true
RAG_CONTEXTUAL_CHUNKS_ENABLED=true
RAG_AGENTIC_ENABLED=true
RAG_HIERARCHY_INDEX_ENABLED=true
RAG_MULTIMODAL_ON_DEMAND_ENABLED=false
RAG_GRAPHRAG_PRIMARY_ENABLED=false

# Hardware execution is simulation-only until a reviewed real adapter exists.
HARDWARE_MODE=simulation

# SMTP email reminder settings.
# Use an app-specific password/authorization code, not your primary mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=
EMAIL_TO=

# Subculture reminder settings.
# Sends an email when days_since_last_subculture >= REMINDER_THRESHOLD_DAYS.
REMINDER_THRESHOLD_DAYS=5
REMINDER_CHECK_INTERVAL_SECONDS=86400
SUBCULTURE_DUE_MONITOR_ENABLED=true
SUBCULTURE_DUE_MONITOR_INTERVAL_SECONDS=300
SUBCULTURE_REMINDER_WINDOWS=09:00,14:00,18:00
SUBCULTURE_REMINDER_WINDOW_MINUTES=30
SUBCULTURE_REMINDER_DAILY_LIMIT=3
SUBCULTURE_REMINDER_MAX_DAYS=2
SUBCULTURE_REMINDER_CYCLE_LIMIT=6

# Email API / scheduler settings. EMAIL_* is the preferred naming;
# SMTP_* remains supported as a fallback.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_TIMEOUT_SECONDS=15
EMAIL_SCHEDULER_ENABLED=false
EMAIL_FRONTEND_DIRECT_SEND=false
MICROALGAE_PASSAGE_DAY_THRESHOLD=5
MICROALGAE_OD750_ALERT_THRESHOLD=1.2
MICROALGAE_STALE_RECORD_DAYS=3
ALGAE_AUTH_MODE=required
ALGAE_API_KEYS_JSON={"replace-viewer-key":{"name":"viewer","role":"viewer"},"replace-scientist-key":{"name":"scientist","role":"scientist"},"replace-approver-key":{"name":"approver","role":"approver"}}
ALGAE_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://127.0.0.1:5173,http://localhost:5173
# Must match a configured key above when the Legacy Streamlit UI is enabled.
ALGAE_FRONTEND_API_KEY=
ALGAE_BIND_HOST=127.0.0.1
ALGAE_AGENT_PORT=8000
ALGAE_FRONTEND_PORT=8501
ALGAE_IMAGE_TAG=local
# Development bind-mount identity. Keep 0 on Windows Docker Desktop; on Linux,
# set these to the output of `id -u` and `id -g` for host-owned data files.
ALGAE_DEV_UID=0
ALGAE_DEV_GID=0
INTENT_ROUTER_MODE=shadow
# Legacy compatibility for one release; prefer INTENT_ROUTER_MODE.
HYBRID_ROUTER_LLM_ENABLED=false

# Context Assembly Pipeline. Use legacy only as a one-release emergency rollback.
CONTEXT_INPUT_MODE=assembled
CONTEXT_INPUT_TOKEN_BUDGET=16000
CONTEXT_SOFT_BUDGET_RATIO=0.60
CONTEXT_HARD_BUDGET_RATIO=0.80
CONTEXT_MAX_ACTIVE_SKILLS=2
CONTEXT_RECENT_MESSAGE_COUNT=6
CONTEXT_RECENT_OBSERVATION_COUNT=2

# User long-term memory. Start in shadow mode, then enable read injection and
# high-confidence low-risk auto-write after evaluation.
USER_MEMORY_ENABLED=false
USER_MEMORY_SHADOW_MODE=true
USER_MEMORY_EXTRACTION_MODEL=deepseek-chat
USER_MEMORY_AUTO_WRITE_THRESHOLD=0.85
USER_MEMORY_MAX_ITEMS=5
USER_MEMORY_CHAR_BUDGET=1000
MEMORY_LEGACY_USER_READ_ENABLED=true
